    "openai": "^4.103.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "stripe": "^18.1.1",
